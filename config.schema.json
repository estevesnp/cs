{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "markers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        ".git",
        ".jj"
      ],
      "description": "identifiers for a project"
    },
    "strategy": {
      "type": "string",
      "enum": [
        "concurrent",
        "blocking"
      ],
      "default": "concurrent",
      "description": "strategy between walking the filesystem and spawning fzf"
    },
    "action": {
      "type": "string",
      "enum": [
        "session",
        "window",
        "print"
      ],
      "default": "session",
      "description": "what to do when a project is selected"
    },
    "edit_mode": {
      "type": "string",
      "enum": [
        "config",
        "roots",
        "dir"
      ],
      "default": "config",
      "description": "what to edit with `cs edit`"
    },
    "preview": {
      "type": "string",
      "default": "ls {}",
      "description": "fzf previewer for projects"
    },
    "continue_on_marker": {
      "type": "boolean",
      "default": false,
      "description": "continue searching dir after finding a marker"
    },
    "ignore_exact_match": {
      "type": "boolean",
      "default": false,
      "description": "don't skip fzf on exact project name match"
    }
  }
}
